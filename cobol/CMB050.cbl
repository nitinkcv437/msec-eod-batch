032000     IF GL-LIMIT NOT NUMERIC OR GL-GEN-COUNT NOT NUMERIC
032100         MOVE 'INVALID LIMIT / GENERATION COUNT' TO WS-DT-MESSAGE
032200         MOVE ZERO TO WS-AGE-DAYS
032300         PERFORM 8000-PRINT-EXCEPTION THRU 8000-EXIT
032400         GO TO 3000-EXIT.
032500*    ROLL-OFF CHECK
032600     IF GL-GEN-COUNT NOT < GL-LIMIT
032700         MOVE 'AT LIMIT - NEXT CATALOG ROLLS OFF OLDEST'
032800                            TO WS-DT-MESSAGE
032900         ADD 1 TO WS-ROLL-WARNINGS
033000         PERFORM 3100-AGE-OF-OLDEST THRU 3100-EXIT
033100         PERFORM 8000-PRINT-EXCEPTION THRU 8000-EXIT
033200     ELSE
033300         IF GL-GEN-COUNT + 1 = GL-LIMIT
033400             MOVE 'ONE GENERATION FROM LIMIT'
033500                            TO WS-DT-MESSAGE
033600             ADD 1 TO WS-ROLL-WARNINGS
033700             PERFORM 3100-AGE-OF-OLDEST THRU 3100-EXIT
033800             PERFORM 8000-PRINT-EXCEPTION THRU 8000-EXIT.
033900*    TAPE CHECKS
034000     IF NOT GL-TAPE
034100         GO TO 3000-EXIT.
034200     PERFORM 3100-AGE-OF-OLDEST THRU 3100-EXIT.
034300     IF WS-AGE-DAYS > WS-RETPD
034400         MOVE 'RETENTION EXCEEDED - SCRATCH ELIGIBLE'
034500                            TO WS-DT-MESSAGE
034600         ADD 1 TO WS-RETN-WARNINGS
034700         PERFORM 8000-PRINT-EXCEPTION THRU 8000-EXIT.
034800     MOVE 'N' TO WS-FOUND-SW.
034900     IF WS-TAPE-COUNT > ZERO
035000         SEARCH ALL WS-TAPE-ENTRY
035100             AT END MOVE 'N' TO WS-FOUND-SW
035200             WHEN WS-TT-VOLSER (TT-IX) = GL-OLDEST-VOLSER
035300                 MOVE 'Y' TO WS-FOUND-SW.
035400     IF WS-FOUND-SW = 'N'
035500         MOVE 'VOLUME NOT IN TAPE LIBRARY' TO WS-DT-MESSAGE
035600         ADD 1 TO WS-MISSING-VOLS
035700         PERFORM 8000-PRINT-EXCEPTION THRU 8000-EXIT
035800         GO TO 3000-EXIT.
035900     IF WS-TT-STATUS (TT-IX) = 'S'
036000         MOVE 'CATALOGED GENERATION ON SCRATCH VOLUME'
036100                            TO WS-DT-MESSAGE
036200         ADD 1 TO WS-MISSING-VOLS
036300         PERFORM 8000-PRINT-EXCEPTION THRU 8000-EXIT.
036400 3000-EXIT.
036500     EXIT.
036600*
036700*    AGE IN DAYS OF THE OLDEST GENERATION (CREATED CCYYDDD)
036800 3100-AGE-OF-OLDEST.
036900     MOVE ZERO TO WS-AGE-DAYS.
037000     IF GL-OLDEST-CREATED NOT NUMERIC OR GL-OLDEST-CREATED = 0
