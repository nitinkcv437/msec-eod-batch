050500 6100-READ-HOLIDAY.
050600     READ HOLIDAY-FILE
050700         AT END
050800             MOVE 'Y' TO WS-HOL-EOF-SW
050900             GO TO 6100-EXIT.
051000     IF WS-HOLIDAY-STATUS NOT = '00'
051100         MOVE '6100-READ-HOLIDAY' TO AB-PARAGRAPH
051200         MOVE 1002               TO AB-ABEND-CODE
051300         MOVE WS-HOLIDAY-STATUS  TO AB-FILE-STATUS
051400         MOVE 'HOLIDAYS'         TO AB-DDNAME
051500         MOVE 'READ FAILED ON HOLIDAY CALENDAR' TO AB-MESSAGE
051600         GO TO 9999-ABEND.
051700     ADD 1 TO WS-HOL-READ.
051800     IF HOL-DATE NOT NUMERIC
051900         GO TO 6100-EXIT.
052000     IF HOL-DATE(1:4) = WS-NEW-BUS-DATE(1:4)
052100         ADD 1 TO WS-HOL-THIS-YEAR.
052200     IF HOL-DATE(1:4) = WS-NEXT-CCYY
052300         ADD 1 TO WS-HOL-NEXT-YEAR.
052400 6100-EXIT.
052500     EXIT.
